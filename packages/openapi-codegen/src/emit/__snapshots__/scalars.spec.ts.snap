"// Generated by @nxgt/openapi-codegen from ../Users/steve/workspace/worktrees/nxgt-http/exact-scalars-1/packages/openapi-codegen/test/fixtures/scalars/openapi.yaml. Do not edit.

import { z } from 'zod';

/** The 400 \`@nxgt/openapi-hono\` or alxia answers a request with when its validators refuse it: the spec is served by either. */
export const zValidationErrorBody = z.union([
	z.object({
		status: z.literal(400),
		message: z.string(),
		timestamp: z.iso.datetime({ offset: true }),
		issues: z.array(z.object({
			target: z.enum(['param', 'query', 'header', 'json', 'form', 'body', 'response']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
	z.object({
		error: z.literal('validation'),
		issues: z.array(z.object({
			target: z.enum(['params', 'query', 'headers', 'cookies', 'body']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
]);

export const zIBAN = z.string().regex(/^[A-Z]{2}\\d{2}[A-Z0-9]{1,30}$/u);

export const zUUID = z.string().regex(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/u);

export const zIP = z.string().regex(/^[0-9a-f.:]+$/u);

export const zDateTime = z.iso.datetime({ offset: true }).regex(/^\\d{4}-\\d{2}-\\d{2}T.*$/u);

export const zAccount = z.object({
	id: zUUID,
	iban: zIBAN,
	bounded: z.string().min(15).max(24).regex(/^[A-Z]{2}\\d{2}[A-Z0-9]{1,30}$/u).optional(),
	mood: z.string().min(1).max(8).optional(),
	lastIp: z.string().max(45).nullable().optional(),
	peers: z.array(zIP).optional(),
	openedAt: zDateTime,
	legacy: z.string().regex(/^L-\\d+$/u).optional(),
});

export const zOpenAccountBody = z.object({
	owner: z.string().regex(/^[^@]+@[^@]+$/u),
});
"
`;

exports[`scalars: exact prints the schema of @nxgt/zod, imported by name where it is used: exact/zod.ts 1`] = `
"// Generated by @nxgt/openapi-codegen from ../Users/steve/workspace/worktrees/nxgt-http/exact-scalars-1/packages/openapi-codegen/test/fixtures/scalars/openapi.yaml. Do not edit.

import { z } from 'zod';
import { emailAddressSchema, emojiSchema, ibanSchema, ipSchema, uuidSchema } from '@nxgt/zod';

/** The 400 \`@nxgt/openapi-hono\` or alxia answers a request with when its validators refuse it: the spec is served by either. */
export const zValidationErrorBody = z.union([
	z.object({
		status: z.literal(400),
		message: z.string(),
		timestamp: z.iso.datetime({ offset: true }),
		issues: z.array(z.object({
			target: z.enum(['param', 'query', 'header', 'json', 'form', 'body', 'response']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
	z.object({
		error: z.literal('validation'),
		issues: z.array(z.object({
			target: z.enum(['params', 'query', 'headers', 'cookies', 'body']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
]);

export const zIBAN = ibanSchema;

export const zUUID = uuidSchema;

export const zIP = ipSchema;

export const zDateTime = z.iso.datetime({ offset: true }).regex(/^\\d{4}-\\d{2}-\\d{2}T.*$/u);

export const zAccount = z.object({
	id: zUUID,
	iban: zIBAN,
	bounded: ibanSchema.check(z.minLength(15), z.maxLength(24)).optional(),
	mood: emojiSchema.check(z.minLength(1), z.maxLength(8)).optional(),
	lastIp: ipSchema.check(z.maxLength(45)).nullable().optional(),
	peers: z.array(zIP).optional(),
	openedAt: zDateTime,
	legacy: z.string().regex(/^L-\\d+$/u).optional(),
});

export const zOpenAccountBody = z.object({
	owner: emailAddressSchema,
});
"
`;

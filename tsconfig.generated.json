{
	// The code the generator writes lands in an app's own source, and is
	// type-checked with the app's settings, whatever they are. So every fixture
	// it generates is checked here with the strictest ones, against the built
	// packages, as an app sees them.
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": [],
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		// The generator's own fixtures have a hono.ts too, and the generator does
		// not depend on the runtime it imports: the runtime's built declarations.
		"paths": {
			"@nxgt/openapi-hono": ["./packages/openapi-hono/dist/index.d.ts"]
		}
	},
	"include": ["packages/*/test/generated/**/*.ts"],
	// The perf fixture's 500 operations are checked by openapi-hono, against
	// its instantiation budget.
	"exclude": ["packages/openapi-hono/test/generated/perf/**"]
}

{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDirs": ["src"],
		"outDir": "dist",
		// The generated fixtures under test/ must type without falling back to any.
		"noImplicitAny": true,
		// The fixtures' hono.ts imports this package by its published name. Its
		// own source, for tsc and for Bun alike, so the specs run the engine
		// they import, not a build of it. Siblings are workspace dependencies.
		"paths": {
			"@nxgt/openapi-hono": ["./src/index.ts"]
		}
	}
}

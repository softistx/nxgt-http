{
	"name": "@alxia/redis",
	"version": "0.0.0",
	"description": "Redis for alxia on @nxgt/redis and @nxgt/redis-guard: a rate-limit store every process shares, idempotent routes, caches and locks in the context",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/redis"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/client": "workspace:^",
		"@alxia/core": "workspace:^",
		"@alxia/rate-limit": "workspace:^",
		"@nxgt/redis": "^0.3.1",
		"@nxgt/redis-guard": "^0.3.1",
		"@types/bun": "^1.3.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"@alxia/rate-limit": "workspace:^",
		"@nxgt/redis": "^0.3.1",
		"@nxgt/redis-guard": "^0.3.1",
		"typescript": "^6.0.3",
		"zod": "^4.6.5"
	},
	"peerDependenciesMeta": {
		"@alxia/rate-limit": {
			"optional": true
		}
	}
}

{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDirs": ["src"],
		"outDir": "dist",
		// The generated goldens under test/ must type without falling back to any.
		"noImplicitAny": true
	},
	// A generated hono.ts imports `@nxgt/openapi-hono`, which depends on this
	// package, never the reverse. `@nxgt/openapi-hono` type-checks the same
	// fixtures' hono.ts, against itself.
	"exclude": ["node_modules", "dist", "test/generated/**/hono.ts"]
}

{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDirs": ["src"],
		"outDir": "dist",
		// The generated goldens under test/ must type without falling back to any.
		"noImplicitAny": true,
		// hono.gen.ts imports the runtime by its published name: the source, here.
		"paths": {
			"@nxgt/openapi-codegen/hono": ["./src/hono/index.ts"]
		}
	}
}

{
	"name": "@alxia/telemetry",
	"version": "0.0.0",
	"description": "Traces and logs for alxia on @nxgt/telemetry: one server span per request around everything it runs, the traceparent continued, the route as its name",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/telemetry"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/client": "workspace:^",
		"@alxia/core": "workspace:^",
		"@nxgt/telemetry": "^0.2.1",
		"@types/bun": "^1.3.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"@nxgt/telemetry": "^0.2.1",
		"typescript": "^6.0.3"
	}
}

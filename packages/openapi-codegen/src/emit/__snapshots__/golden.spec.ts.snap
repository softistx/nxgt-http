"// Generated by @nxgt/openapi-codegen from ../../fixtures/dates/openapi.yaml. Do not edit.

import { z } from 'zod';
import type { Event, EventInput } from './types.js';

/** An RFC 3339 date-time, decoded to a Date and encoded back. */
const isoDate = {
	decode: (value: string): Date => new Date(value),
	encode: (date: Date): string => date.toISOString(),
};

export const zTimestamp = z.codec(z.iso.datetime({ offset: true }), z.date(), isoDate);

export const zNewEvent = z.object({
	title: z.string(),
	startsAt: zTimestamp,
	endsAt: z.codec(z.iso.datetime({ offset: true }), z.date(), isoDate).nullable().optional(),
	remindAt: z.codec(z.iso.datetime({ offset: true }), z.date(), isoDate).prefault('2024-01-01T09:00:00Z'),
	day: z.iso.date().optional(),
});

export const zEvent: z.ZodType<Event, EventInput> = zNewEvent.extend({
	id: z.string(),
	createdAt: z.codec(z.iso.datetime({ offset: true }), z.date(), isoDate),
	history: z.array(zTimestamp).optional(),
	get parent() {
		return zEvent.optional();
	},
});

export const zRescheduleEventBody = z.object({
	at: z.codec(z.iso.datetime({ offset: true }), z.date(), isoDate),
	notify: z.array(z.codec(z.iso.datetime({ offset: true }), z.date(), isoDate)).optional(),
});
"
`;


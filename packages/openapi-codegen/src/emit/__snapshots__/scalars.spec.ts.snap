// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`scalars: pattern checks a scalar by its pattern and imports nothing of @nxgt/zod: pattern/zod.ts 1`] = `
"
import { z } from 'zod';

/** The 400 \`@nxgt/openapi-hono\` or alxia answers a request with when its validators refuse it: the spec is served by either. */
export const zValidationErrorBody = z.union([
	z.object({
		status: z.literal(400),
		message: z.string(),
		timestamp: z.iso.datetime({ offset: true }),
		issues: z.array(z.object({
			target: z.enum(['param', 'query', 'header', 'json', 'form', 'body', 'response']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
	z.object({
		error: z.literal('validation'),
		issues: z.array(z.object({
			target: z.enum(['params', 'query', 'headers', 'cookies', 'body']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
]);

export const zIBAN = z.string().regex(/^[A-Z]{2}\\d{2}[A-Z0-9]{1,30}$/u);

/** An IBAN narrowed to France, as \`@pattern("^FR.*$") scalar FrIban extends iban\`. */
export const zFrIban = z.string().regex(/^FR.*$/u);

export const zUUID = z.string().regex(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/u);

export const zIP = z.string().regex(/^[0-9a-f.:]+$/u);

export const zDateTime = z.iso.datetime({ offset: true }).regex(/^\\d{4}-\\d{2}-\\d{2}T.*$/u);

export const zAccount = z.object({
	id: zUUID,
	iban: zIBAN,
	bounded: z.string().min(15).max(24).regex(/^[A-Z]{2}\\d{2}[A-Z0-9]{1,30}$/u).optional(),
	mood: z.string().min(1).max(8).optional(),
	lastIp: z.string().max(45).nullable().optional(),
	peers: z.array(zIP).optional(),
	openedAt: zDateTime,
	legacy: z.string().regex(/^L-\\d+$/u).optional(),
});

export const zPositiveInt = z.int32().min(1).max(2147483647);

export const zPort = z.int32().min(0).max(65535);

/** A Port narrowed to the well-known ones, as \`@maxValue(1023) scalar WellKnownPort extends port\`. */
export const zWellKnownPort = z.int32().min(0).max(1023);

export const zLatitude = z.number().min(-90).max(90);

export const zLongitude = z.number().min(-180).max(180);

export const zPositiveFloat = z.number().gt(0);

export const zSafeInt = z.int().min(-9007199254740991).max(9007199254740991);

export const zPlace = z.object({
	latitude: zLatitude,
	longitude: zLongitude,
	radius: z.number().gt(0).max(1000).multipleOf(0.5).optional(),
	port: zWellKnownPort.optional(),
	rank: z.int32().min(1).max(2147483647).nullable().optional(),
	ids: z.array(zSafeInt).optional(),
	weight: z.number().optional(),
	count: z.int().min(0).optional(),
});

export const zOpenAccountBody = z.object({
	owner: z.string().regex(/^[^@]+@[^@]+$/u),
});

export const zAddPlaceBody = z.object({
	latitude: z.number().min(-90).max(90),
});
"
`;

exports[`scalars: exact prints the schema of @nxgt/zod, imported by name where it is used: exact/zod.ts 1`] = `
"
import { z } from 'zod';
import {
	emailAddressSchema,
	emojiSchema,
	ibanSchema,
	ipSchema,
	latitudeSchema,
	longitudeSchema,
	portSchema,
	positiveFloatSchema,
	positiveIntSchema,
	safeIntSchema,
	uuidSchema,
} from '@nxgt/zod';

/** The 400 \`@nxgt/openapi-hono\` or alxia answers a request with when its validators refuse it: the spec is served by either. */
export const zValidationErrorBody = z.union([
	z.object({
		status: z.literal(400),
		message: z.string(),
		timestamp: z.iso.datetime({ offset: true }),
		issues: z.array(z.object({
			target: z.enum(['param', 'query', 'header', 'json', 'form', 'body', 'response']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
	z.object({
		error: z.literal('validation'),
		issues: z.array(z.object({
			target: z.enum(['params', 'query', 'headers', 'cookies', 'body']),
			path: z.array(z.union([z.string(), z.int()])),
			code: z.string(),
			message: z.string(),
		})),
	}),
]);

export const zIBAN = ibanSchema.check(z.regex(/^[A-Z]{2}\\d{2}[A-Z0-9]{1,30}$/u, 'Invalid string: must match pattern /^[A-Z]{2}\\\\d{2}[A-Z0-9]{1,30}$/u'));

/** An IBAN narrowed to France, as \`@pattern("^FR.*$") scalar FrIban extends iban\`. */
export const zFrIban = ibanSchema.check(z.regex(/^FR.*$/u, 'Invalid string: must match pattern /^FR.*$/u'));

export const zUUID = uuidSchema.check(z.regex(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/u, 'Invalid string: must match pattern /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/u'));

export const zIP = ipSchema.check(z.regex(/^[0-9a-f.:]+$/u, 'Invalid string: must match pattern /^[0-9a-f.:]+$/u'));

export const zDateTime = z.iso.datetime({ offset: true }).regex(/^\\d{4}-\\d{2}-\\d{2}T.*$/u);

export const zAccount = z.object({
	id: zUUID,
	iban: zIBAN,
	bounded: ibanSchema.check(z.minLength(15, 'Too small: expected string to have >=15 characters'), z.maxLength(24, 'Too big: expected string to have <=24 characters')).check(z.regex(/^[A-Z]{2}\\d{2}[A-Z0-9]{1,30}$/u, 'Invalid string: must match pattern /^[A-Z]{2}\\\\d{2}[A-Z0-9]{1,30}$/u')).optional(),
	mood: emojiSchema.check(z.minLength(1, 'Too small: expected string to have >=1 characters'), z.maxLength(8, 'Too big: expected string to have <=8 characters')).optional(),
	lastIp: ipSchema.check(z.maxLength(45, 'Too big: expected string to have <=45 characters')).nullable().optional(),
	peers: z.array(zIP).optional(),
	openedAt: zDateTime,
	legacy: z.string().regex(/^L-\\d+$/u).optional(),
});

export const zPositiveInt = positiveIntSchema;

export const zPort = portSchema;

/** A Port narrowed to the well-known ones, as \`@maxValue(1023) scalar WellKnownPort extends port\`. */
export const zWellKnownPort = portSchema.check(z.lte(1023, 'Too big: expected number to be <=1023'));

export const zLatitude = latitudeSchema;

export const zLongitude = longitudeSchema;

export const zPositiveFloat = positiveFloatSchema;

export const zSafeInt = safeIntSchema;

export const zPlace = z.object({
	latitude: zLatitude,
	longitude: zLongitude,
	radius: positiveFloatSchema.check(z.lte(1000, 'Too big: expected number to be <=1000'), z.multipleOf(0.5, 'Invalid number: must be a multiple of 0.5')).optional(),
	port: zWellKnownPort.optional(),
	rank: positiveIntSchema.nullable().optional(),
	ids: z.array(zSafeInt).optional(),
	weight: z.number().optional(),
	count: z.int().min(0).optional(),
});

export const zOpenAccountBody = z.object({
	owner: emailAddressSchema.check(z.regex(/^[^@]+@[^@]+$/u, 'Invalid string: must match pattern /^[^@]+@[^@]+$/u')),
});

export const zAddPlaceBody = z.object({
	latitude: latitudeSchema,
});
"
`;

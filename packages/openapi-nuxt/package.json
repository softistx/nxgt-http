{
	"name": "@nxgt/openapi-nuxt",
	"version": "0.2.1",
	"license": "MIT",
	"type": "module",
	"main": "./dist/module.js",
	"types": "./dist/module.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/module.d.ts",
			"import": "./dist/module.js",
			"default": "./dist/module.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js",
			"default": "./dist/runtime/index.js"
		},
		"./hono": {
			"types": "./dist/hono/index.d.ts",
			"import": "./dist/hono/index.js",
			"default": "./dist/hono/index.js"
		},
		"./query": {
			"types": "./dist/query/index.d.ts",
			"import": "./dist/query/index.js",
			"default": "./dist/query/index.js"
		},
		"./package.json": "./package.json"
	},
	"nxgt": {
		"entrypoints": [
			"src/module.ts",
			"src/runtime/index.ts",
			"src/hono/index.ts",
			"src/query/index.ts"
		]
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-http.git",
		"directory": "packages/openapi-nuxt"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"fixtures": "bun run test/generate.ts",
		"test": "bun run fixtures && bun test src",
		"typecheck": "bun run fixtures && tsc --noEmit && nuxi prepare test/app && tsc --noEmit -p test/app/.nuxt/tsconfig.app.json && tsc --noEmit -p test/app/.nuxt/tsconfig.server.json"
	},
	"dependencies": {
		"@nuxt/kit": "^4.0.0",
		"@nuxt/schema": "^4.0.0",
		"h3": "^1.15.0"
	},
	"devDependencies": {
		"@nxgt/httpyz": "workspace:^",
		"@nxgt/httpyz-query": "workspace:^",
		"@nxgt/openapi-codegen": "workspace:^",
		"@nxgt/openapi-hono": "workspace:^",
		"@nxgt/openapi-httpyz": "workspace:^",
		"@tanstack/vue-query": "^5.102.8",
		"@types/bun": "^1.4.0",
		"hono": "^4.13.4",
		"nuxt": "^4.5.2",
		"vue": "^3.5.0",
		"zod": "^4.5.4"
	},
	"peerDependencies": {
		"@nxgt/httpyz": "workspace:^",
		"@nxgt/httpyz-query": "workspace:^",
		"@nxgt/openapi-httpyz": "workspace:^",
		"@tanstack/vue-query": "^5.90.0",
		"hono": "^4.0.0",
		"nuxt": "^4.0.0",
		"typescript": "^6.0.3",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"@nxgt/httpyz-query": {
			"optional": true
		},
		"@tanstack/vue-query": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	}
}

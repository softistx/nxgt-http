{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDirs": ["src"],
		"outDir": "dist",
		// The generated goldens under test/ must type without falling back to any.
		"noImplicitAny": true,
		// hono.ts imports its runtime by its published name: the source beside
		// this package, for tsc and for Bun alike. A path, not a dependency:
		// `@nxgt/openapi-hono` generates its own fixtures with this package, and
		// a dependency both ways would be a cycle. The build still roots at src.
		"rootDir": "..",
		"paths": {
			"@nxgt/openapi-hono": ["../openapi-hono/src/index.ts"]
		}
	}
}

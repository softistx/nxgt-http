{
	"name": "@alxia/i18n",
	"version": "0.0.0",
	"description": "Translations for alxia on @nxgt/i18n: t() bound to the request's language, keys typed by your catalogue, ICU messages",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/alxia.git",
		"directory": "packages/i18n"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"alxia": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@alxia/core": "workspace:^",
		"@alxia/language": "workspace:^",
		"@nxgt/i18n": "^1.1.0",
		"@types/bun": "^1.3.0"
	},
	"peerDependencies": {
		"@alxia/core": "workspace:^",
		"@alxia/language": "workspace:^",
		"@nxgt/i18n": "^1.1.0",
		"typescript": "^6.0.3"
	}
}

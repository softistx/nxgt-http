>(
	app: Hono.Hono<any, any, any>,
	options?: runtime.RoutesOptions<Prefix, Tag>,
): runtime.Routes<HonoSpec, runtime.ScopeOf<HonoSpec, Tag>, Prefix> =>
	createApi(options).routes(app, options);
"

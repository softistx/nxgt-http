{
	"name": "@nxgt/datasource-rest",
	"version": "1.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteveGT96/nxgt-core.git",
		"directory": "packages/datasource-rest"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"dependencies": {
		"lodash": "^4.18.1",
		"@nxgt/shared": "workspace:*",
		"@nxgt/shared-exceptions": "workspace:*",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/lodash": "^4.17.24"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
